# ---- WhatsApp Cloud API (Meta developer dashboard)
ACCESS_TOKEN=""
APP_ID=""
APP_SECRET=""
PHONE_NUMBER_ID=""
VERSION="v21.0"
VERIFY_TOKEN=""

# ---- Groq
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-20b"
STT_MODEL="whisper-large-v3-turbo"
TTS_MODEL="canopylabs/orpheus-v1-english"
# English voices: autumn, diana, hannah (female) and austin, daniel, troy (male)
TTS_VOICE="troy"

# ---- Optional
# Build the knowledge base automatically on the first `python run.py` (true/false)
AUTO_BUILD_KB="true"
# Embedding model for RAG (changing it requires: python build_knowledge_base.py --reindex)
# EMBEDDING_MODEL="sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2"
# PORT="8000"
